### 0. 로그인 (토큰 발급)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "cookie@gmail.com",
  "password": "12345678"
}

> {%
    client.global.set("auth_token", "Bearer " + response.body.data.token);
%}

### =========================================================================
### [필수 진행] 최근 주문 내역 조회 및 변수 자동 세팅
### =========================================================================
GET http://localhost:8080/api/orders
Authorization: {{auth_token}}

> {%
    var orders = response.body.data;
    if (orders && orders.length > 0) {
        var latestOrder = orders[0];
        client.global.set("paymentId", latestOrder.paymentId);

        client.log("✅ 추출된 paymentId: " + latestOrder.paymentId);

        if (latestOrder.orderItems && latestOrder.orderItems.length > 0) {
            client.log("--- 🛒 주문 상품 목록 (" + latestOrder.orderItems.length + "개) ---");
            for (var i = 0; i < latestOrder.orderItems.length; i++) {
                var item = latestOrder.orderItems[i];
                // 변수명 자동 생성: orderItemId1, orderItemId2 ...
                client.global.set("orderItemId" + (i+1), item.orderItemId);
                client.global.set("orderItemQty" + (i+1), item.quantity);
                client.log("👉 [상품 " + (i+1) + "] ID: " + item.orderItemId + " / 이름: " + item.productName + " / 수량: " + item.quantity + "개");
            }
            client.log("-----------------------------------");
        }
    } else {
        client.log("⚠️ 주문 내역이 없습니다! (결제를 먼저 진행해주세요)");
    }
%}


### =========================================================================
### [시나리오 #1, #2] 전액 환불 테스트 (단독 결제 / 복합 결제)
### 주문한 상품 수량 전체를 요청합니다.
### (화면에서 포인트 0원 적용 시 시나리오 1, 포인트 섞어서 결제 시 시나리오 2 확인 가능)
### =========================================================================
POST http://localhost:8080/api/refunds
Authorization: {{auth_token}}
Content-Type: application/json

{
  "paymentId": {{paymentId}},
  "cancelReason": "시나리오 1,2: 전액 환불",
  "items": [
    {
      "orderItemId": {{orderItemId1}},
      "requestQuantity": {{orderItemQty1}}
    }
  ]
}

### =========================================================================
### [시나리오 #3-1] 부분 환불 테스트 (상품 1번을 환불)
### 상품 1번에서 수량 1개만 부분 환불합니다. (복합결제 시 비율 배분 확인용)
### =========================================================================
POST http://localhost:8080/api/refunds
Authorization: {{auth_token}}
Content-Type: application/json

{
  "paymentId": {{paymentId}},
  "cancelReason": "1개 부분 환불",
  "items": [
    {
      "orderItemId": {{orderItemId1}},
      "requestQuantity": 1
    }
  ]
}


### =========================================================================
### [시나리오 3-2] 부분 환불 테스트 (상품 2번을 환불)
### 장바구니에 서로 다른 상품을 여러 개 담아 결제했을 때 사용하세요.
### =========================================================================
POST http://localhost:8080/api/refunds
Authorization: {{auth_token}}
Content-Type: application/json

{
"paymentId": {{paymentId}},
"cancelReason": "상품 2번 부분 환불",
"items": [
{
"orderItemId": {{orderItemId2}},
"requestQuantity": 1
}
]
}


### =========================================================================
### [시나리오 #6] 중복 환불 요청
### 아래 요청의 실행 버튼을 마우스로 아주 빠르게 더블 클릭
### 첫 번째는 성공(200), 두 번째는 TOO_MANY_REQUESTS(429) 실패가 떠야 정상입니다.
### =========================================================================
POST http://localhost:8080/api/refunds
Authorization: {{auth_token}}
Content-Type: application/json

{
  "paymentId": {{paymentId}},
  "cancelReason": "시나리오 6: 중복 환불 시도",
  "items": [
    {
      "orderItemId": {{orderItemId1}},
      "requestQuantity": 1
    }
  ]
}


### =========================================================================
### [예외 테스트] 잔여 수량 초과 환불 테스트 (REFUND_005 검증)
### =========================================================================
POST http://localhost:8080/api/refunds
Authorization: {{auth_token}}
Content-Type: application/json

{
  "paymentId": {{paymentId}},
  "cancelReason": "초과 환불 테스트",
  "items": [
    {
      "orderItemId": {{orderItemId1}},
      "requestQuantity": 999 
    }
  ]
}